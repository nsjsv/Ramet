# 复制为 .env 后按需修改，docker-compose.prod.yml 会读取它。全部可选。

# 数据库密码：只在首次建库（./postgres-data 为空）时生效，之后要改得进库里改
POSTGRES_PASSWORD=change-me

# 对外端口
WEB_PORT=8080

# 可选：把图片镜像到 CloudFlare-ImgBed 图床，URL 与 TOKEN 都设了才开启；本地 uploads 始终保留正本
RAMET_IMGBED_URL=
RAMET_IMGBED_TOKEN=
RAMET_IMGBED_PUBLIC_URL=

# 可选：网页书签 / 提及的元信息抓取中继（Cloudflare Worker，见 cloudflare/link-fetch/worker.js），
# 设了就一律请它代抓、服务器不直连（服务器连不上某些网站时用）；URL 与 SECRET 都设了才开启
RAMET_LINK_RELAY_URL=
RAMET_LINK_RELAY_SECRET=
